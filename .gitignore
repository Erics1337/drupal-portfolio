# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
console/

# Ignore sensitive information
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore Twig cache files
/web/sites/*/files/php/
/web/sites/*/files/css/
/web/sites/*/files/js/
/web/sites/*/files/styles/
/web/sites/*/files/php/twig/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env

# Ignore mounts
# web/sites/default/files
tmp
private
.drush
drush-backups
.console
/.editorconfig
/.gitattributes

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs
/web/sites/*/logs/

# Ignore database dumps
*.sql
*.sql.gz

# Ignore generated translation files
/web/sites/*/translations/

# Ignore composer.lock to allow for different environments
# composer.lock
